# ==============================================================================
# AI-Powered Google Review Assistance SaaS — Backend Environment Configuration
# ==============================================================================
# This template documents all environment variables used by @review-system/backend.
# Copy this file to `.env` for local development or set these variables in your
# staging/production secrets manager.
#
# NOTE: Never commit sensitive credentials or real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Environment
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'test', or 'production'
# Default: development
NODE_ENV=development

# Network port for HTTP listener
# Default: 3000
PORT=3000

# Network host address to bind
# Default: 0.0.0.0
HOST=0.0.0.0

# Trusted reverse proxy IPs/CIDRs for client IP extraction (X-Forwarded-For)
# In production behind Nginx/Cloudflare, set to the trusted reverse proxy IP(s).
# Default: 127.0.0.1,::1
TRUSTED_PROXIES=127.0.0.1,::1

# Shared secret for authenticating Cloudflare Pages Function reverse-proxy identity.
# In production:
# - MUST be set to a cryptographically strong secret of at least 32 characters.
# - Matches the INTERNAL_PROXY_SECRET binding configured in Cloudflare Pages Functions.
# - Used by backend to authenticate forwarded client IP assertions and prevent direct public bypass.
INTERNAL_PROXY_SECRET=

# ------------------------------------------------------------------------------
# 2. Database Configuration (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled PostgreSQL connection URI for standard runtime queries.
# Uses Neon's connection pooler endpoint (e.g., -pooler in hostname).
# In development/test, if omitted, an in-memory PGlite instance is used as fallback.
# In staging/production, this MUST be set to Neon's pooled PostgreSQL instance.
# Example: postgresql://user:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Direct (non-pooled) PostgreSQL connection URI for startup migrations.
# In production, this MUST be set to Neon's direct endpoint (without -pooler in hostname).
# Direct connection is strictly required for session-level PostgreSQL advisory locks (pg_advisory_lock),
# which are not supported by Neon's transaction-mode connection pooler.
# Example: postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
MIGRATION_DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Session & Cookie Security
# ------------------------------------------------------------------------------
# Cryptographic secret used for cookie signing and session validation.
# PRODUCTION REQUIREMENTS:
# - MUST be explicitly supplied.
# - MUST NOT be the fallback string.
# - MUST be at least 32 characters long (recommended: 64 hex characters).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=super-secret-session-key-must-be-at-least-32-chars-long!

# Enforce Secure attribute on session and ephemeral customer cookies.
# - In production: defaults to true if unset.
# - In development/test: defaults to false.
# Set explicitly to true when running behind HTTPS.
COOKIE_SECURE=false

# Optional domain attribute for cookies (e.g. '.yourdomain.com' for subdomains).
# Leave unset if serving directly from the host domain.
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 4. CORS & Origin Whitelisting
# ------------------------------------------------------------------------------
# Primary public URL of the customer-facing frontend.
# Requests from this origin are granted credentialed CORS access.
# Default: http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Comma-separated list of additional allowed origins for credentialed CORS.
# Example: https://app.example.com,https://merchant.example.com
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 5. AI Assistant & LLM Provider Configuration
# ------------------------------------------------------------------------------
# Master feature flag enabling customer-facing AI review draft polishing.
# Set to 'true' to enable or 'false' to disable AI endpoints.
# Default: false
ENABLE_AI_ASSISTANT=false

# AI Provider adapter: 'mock' (local deterministic generator) or 'groq' (production LLM)
# Default: mock
AI_PROVIDER=mock

# Model identifier for the AI provider
# Default: openai/gpt-oss-20b
AI_MODEL=openai/gpt-oss-20b

# Groq API key (Required if AI_PROVIDER is set to 'groq')
# Safe placeholder: gsk_...
GROQ_API_KEY=
